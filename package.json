{
  "name": "agent-flight-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names WEB,API \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/react": "^4.0.82",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/kode-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.79",
    "cesium": "^1.144.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "webmcp-types": "^0.1.3"
  },
  "description": "A shared-cockpit flight simulator for a human pilot and AI copilot"
}
